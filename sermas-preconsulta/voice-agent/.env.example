# ── LLM backend ──────────────────────────────────────────────────────────────
# Opciones: "ollama" (local, gratis) | "groq" (nube, gratis) | "openai" (producción)
LLM_BACKEND=ollama

# Ollama — modelo local (ollama pull llama3.2)
OLLAMA_MODEL=llama3.1:8b

# Groq — API gratuita (console.groq.com)
# GROQ_API_KEY=gsk_...

# OpenAI — producción SERMAS
# OPENAI_API_KEY=sk-...

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL pública de este servicio (ngrok en local, dominio real en prod)
# Twilio necesita HTTPS/WSS — usar: ngrok http 8000
BASE_URL=https://xxxx.ngrok-free.app

# URL del fhir-service (interno en Docker Compose)
FHIR_SERVICE_URL=http://fhir-service:8001