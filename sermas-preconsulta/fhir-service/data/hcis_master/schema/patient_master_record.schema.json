{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drAid.local/schemas/patient_master_record.schema.json",
  "title": "HCIS Patient Master Record",
  "type": "object",
  "required": [
    "metadata",
    "patient_demographics",
    "sections",
    "documents_registry",
    "all_sections_index"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "schema_version",
        "record_id",
        "patient_cip",
        "source_system",
        "generated_at"
      ],
      "properties": {
        "schema_version": { "type": "string" },
        "record_id": { "type": "string" },
        "patient_cip": { "type": "string" },
        "source_system": { "type": "string" },
        "generated_at": { "type": "string", "format": "date-time" },
        "ingestion_notes": { "type": "string" }
      }
    },
    "patient_demographics": {
      "type": "object",
      "required": [
        "cip",
        "full_name",
        "sex",
        "birth_date"
      ],
      "properties": {
        "cip": { "type": "string" },
        "full_name": { "type": "string" },
        "sex": { "type": "string" },
        "birth_date": { "type": "string", "format": "date" },
        "age": { "type": "integer" },
        "national_id_masked": { "type": "string" },
        "contact": {
          "type": "object",
          "properties": {
            "phone_masked": { "type": "string" },
            "city": { "type": "string" }
          }
        }
      }
    },
    "sections": {
      "type": "object",
      "required": [
        "history_summary",
        "encounters",
        "diagnoses",
        "procedures",
        "medications",
        "allergies_adrs",
        "lab_results",
        "imaging_reports",
        "discharge_summaries",
        "clinical_notes",
        "nursing_notes",
        "interconsultations",
        "documents"
      ],
      "properties": {
        "history_summary": { "$ref": "#/$defs/traceableObject" },
        "encounters": {
          "type": "array",
          "items": { "$ref": "#/$defs/encounter" }
        },
        "diagnoses": {
          "type": "array",
          "items": { "$ref": "#/$defs/diagnosis" }
        },
        "procedures": {
          "type": "array",
          "items": { "$ref": "#/$defs/procedure" }
        },
        "medications": {
          "type": "array",
          "items": { "$ref": "#/$defs/medication" }
        },
        "allergies_adrs": {
          "type": "array",
          "items": { "$ref": "#/$defs/allergyAdr" }
        },
        "lab_results": {
          "type": "array",
          "items": { "$ref": "#/$defs/labResult" }
        },
        "imaging_reports": {
          "type": "array",
          "items": { "$ref": "#/$defs/imagingReport" }
        },
        "discharge_summaries": {
          "type": "array",
          "items": { "$ref": "#/$defs/dischargeSummary" }
        },
        "clinical_notes": {
          "type": "array",
          "items": { "$ref": "#/$defs/clinicalNote" }
        },
        "nursing_notes": {
          "type": "array",
          "items": { "$ref": "#/$defs/clinicalNote" }
        },
        "interconsultations": {
          "type": "array",
          "items": { "$ref": "#/$defs/interconsultation" }
        },
        "documents": {
          "type": "array",
          "items": { "$ref": "#/$defs/documentRef" }
        }
      }
    },
    "documents_registry": {
      "type": "array",
      "items": { "$ref": "#/$defs/documentBlob" }
    },
    "all_sections_index": {
      "description": "Fragmentos normalizados para embeddings/busqueda",
      "type": "array",
      "items": { "$ref": "#/$defs/indexFragment" }
    }
  },
  "$defs": {
    "traceability": {
      "type": "object",
      "required": [
        "source_section",
        "timestamp",
        "author",
        "confidence",
        "manual_review",
        "evidence_text"
      ],
      "properties": {
        "source_section": { "type": "string" },
        "source_resource_type": { "type": "string" },
        "source_document_id": { "type": "string" },
        "timestamp": { "type": "string" },
        "author": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "manual_review": { "type": "boolean" },
        "evidence_text": { "type": "string" }
      }
    },
    "traceableObject": {
      "type": "object",
      "required": ["content", "traceability"],
      "properties": {
        "content": { "type": "string" },
        "traceability": { "$ref": "#/$defs/traceability" }
      }
    },
    "encounter": {
      "type": "object",
      "required": ["encounter_id", "care_setting", "date_start", "reason", "traceability"],
      "properties": {
        "encounter_id": { "type": "string" },
        "care_setting": { "type": "string" },
        "date_start": { "type": "string" },
        "date_end": { "type": "string" },
        "specialty": { "type": "string" },
        "reason": { "type": "string" },
        "outcome": { "type": "string" },
        "traceability": { "$ref": "#/$defs/traceability" }
      }
    },
    "diagnosis": {
      "type": "object",
      "required": ["name", "status", "traceability"],
      "properties": {
        "name": { "type": "string" },
        "coding_system": { "type": "string" },
        "code": { "type": "string" },
        "status": { "type": "string" },
        "onset_date": { "type": "string" },
        "traceability": { "$ref": "#/$defs/traceability" }
      }
    },
    "procedure": {
      "type": "object",
      "required": ["name", "date", "traceability"],
      "properties": {
        "name": { "type": "string" },
        "category": { "type": "string" },
        "date": { "type": "string" },
        "status": { "type": "string" },
        "notes": { "type": "string" },
        "traceability": { "$ref": "#/$defs/traceability" }
      }
    },
    "medication": {
      "type": "object",
      "required": ["name", "status", "traceability"],
      "properties": {
        "name": { "type": "string" },
        "dose": { "type": "string" },
        "frequency": { "type": "string" },
        "route": { "type": "string" },
        "status": { "type": "string" },
        "traceability": { "$ref": "#/$defs/traceability" }
      }
    },
    "allergyAdr": {
      "type": "object",
      "required": ["substance", "criticality", "traceability"],
      "properties": {
        "substance": { "type": "string" },
        "criticality": { "type": "string" },
        "reaction": { "type": "string" },
        "traceability": { "$ref": "#/$defs/traceability" }
      }
    },
    "labResult": {
      "type": "object",
      "required": ["test_name", "date", "traceability"],
      "properties": {
        "test_name": { "type": "string" },
        "date": { "type": "string" },
        "value": { "type": "string" },
        "unit": { "type": "string" },
        "reference_range": { "type": "string" },
        "interpretation": { "type": "string" },
        "traceability": { "$ref": "#/$defs/traceability" }
      }
    },
    "imagingReport": {
      "type": "object",
      "required": ["study", "date", "impression", "traceability"],
      "properties": {
        "study": { "type": "string" },
        "date": { "type": "string" },
        "impression": { "type": "string" },
        "traceability": { "$ref": "#/$defs/traceability" }
      }
    },
    "dischargeSummary": {
      "type": "object",
      "required": ["date", "service", "summary", "traceability"],
      "properties": {
        "date": { "type": "string" },
        "service": { "type": "string" },
        "summary": { "type": "string" },
        "traceability": { "$ref": "#/$defs/traceability" }
      }
    },
    "clinicalNote": {
      "type": "object",
      "required": ["note_type", "date", "text", "traceability"],
      "properties": {
        "note_type": { "type": "string" },
        "date": { "type": "string" },
        "text": { "type": "string" },
        "traceability": { "$ref": "#/$defs/traceability" }
      }
    },
    "interconsultation": {
      "type": "object",
      "required": ["requested_service", "date", "question", "traceability"],
      "properties": {
        "requested_service": { "type": "string" },
        "date": { "type": "string" },
        "question": { "type": "string" },
        "response": { "type": "string" },
        "traceability": { "$ref": "#/$defs/traceability" }
      }
    },
    "documentRef": {
      "type": "object",
      "required": ["document_id", "title", "section", "content_type", "traceability"],
      "properties": {
        "document_id": { "type": "string" },
        "title": { "type": "string" },
        "section": { "type": "string" },
        "content_type": { "type": "string" },
        "storage_ref": { "type": "string" },
        "text_preview": { "type": "string" },
        "traceability": { "$ref": "#/$defs/traceability" }
      }
    },
    "documentBlob": {
      "type": "object",
      "required": ["document_id", "filename", "content_type", "path"],
      "properties": {
        "document_id": { "type": "string" },
        "filename": { "type": "string" },
        "content_type": { "type": "string" },
        "path": { "type": "string" },
        "sha256": { "type": "string" }
      }
    },
    "indexFragment": {
      "type": "object",
      "required": ["fragment_id", "source_section", "timestamp", "author", "text"],
      "properties": {
        "fragment_id": { "type": "string" },
        "source_section": { "type": "string" },
        "resource_type": { "type": "string" },
        "timestamp": { "type": "string" },
        "author": { "type": "string" },
        "text": { "type": "string" },
        "confidence": { "type": "number" },
        "manual_review": { "type": "boolean" },
        "source_document_id": { "type": "string" }
      }
    }
  }
}
