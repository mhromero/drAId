{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drAid.local/schemas/patient_master_record.schema.json",
  "title": "Patient Master Record v1",
  "type": "object",
  "required": [
    "schema_version",
    "record_id",
    "patient_demographics",
    "document_index",
    "encounters",
    "diagnoses",
    "procedures",
    "medications",
    "allergies_adrs",
    "lab_results",
    "imaging_reports",
    "other_diagnostic_tests",
    "clinical_notes",
    "discharge_summaries",
    "attachments",
    "evidence_spans",
    "source_refs",
    "all_sections"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "record_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "patient_demographics": {
      "type": "object",
      "required": ["patient_id", "name", "family_name_1", "birth_date", "sex_at_birth"],
      "properties": {
        "patient_id": { "type": ["string", "null"] },
        "cip_sns": { "type": ["string", "null"] },
        "cip_aut": { "type": ["string", "null"] },
        "nhc": { "type": ["string", "null"] },
        "dni_nie": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"] },
        "family_name_1": { "type": ["string", "null"] },
        "family_name_2": { "type": ["string", "null"] },
        "birth_date": { "type": ["string", "null"] },
        "sex_at_birth": { "type": ["string", "null"] },
        "phones": { "type": "array", "items": { "type": "string" } },
        "email": { "type": ["string", "null"] },
        "address": { "type": "object" },
        "primary_care_center": { "type": "object" }
      }
    },
    "document_index": { "type": "array", "items": { "$ref": "#/$defs/document" } },
    "encounters": { "type": "array", "items": { "type": "object" } },
    "diagnoses": { "type": "array", "items": { "type": "object" } },
    "active_problems": { "type": "array", "items": { "type": "object" } },
    "procedures": { "type": "array", "items": { "type": "object" } },
    "medications": { "type": "array", "items": { "type": "object" } },
    "allergies_adrs": { "type": "array", "items": { "type": "object" } },
    "lab_results": { "type": "array", "items": { "type": "object" } },
    "imaging_reports": { "type": "array", "items": { "type": "object" } },
    "other_diagnostic_tests": { "type": "array", "items": { "type": "object" } },
    "clinical_notes": { "type": "array", "items": { "type": "object" } },
    "discharge_summaries": { "type": "array", "items": { "type": "object" } },
    "nursing_care": { "type": "array", "items": { "type": "object" } },
    "attachments": { "type": "array", "items": { "$ref": "#/$defs/attachment" } },
    "evidence_spans": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "source_refs": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" } },
    "all_sections": { "type": "array", "items": { "$ref": "#/$defs/section" } },
    "traceability": { "type": "object" },
    "conflict_resolution": { "type": "object" }
  },
  "$defs": {
    "document": {
      "type": "object",
      "required": ["doc_id", "doc_type", "title", "source_refs"],
      "properties": {
        "doc_id": { "type": "string" },
        "doc_type": {
          "type": "string",
          "enum": ["HCR", "ICAP", "ICU", "ICA", "ICCE", "ICE", "IRPL", "IRPI", "IROPD", "OTHER"]
        },
        "title": { "type": "string" },
        "authored_at": { "type": ["string", "null"] },
        "status": { "type": ["string", "null"] },
        "raw_text": { "type": ["string", "null"] },
        "attachments": { "type": "array", "items": { "type": "string" } },
        "source_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "attachment": {
      "type": "object",
      "required": ["id", "doc_id", "mime_type", "file_name", "storage_uri"],
      "properties": {
        "id": { "type": "string" },
        "doc_id": { "type": "string" },
        "mime_type": { "type": "string" },
        "file_name": { "type": "string" },
        "storage_uri": { "type": "string" },
        "extracted_text": { "type": ["string", "null"] }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["id", "doc_id", "text_quote"],
      "properties": {
        "id": { "type": "string" },
        "doc_id": { "type": "string" },
        "text_quote": { "type": "string" },
        "page": { "type": ["integer", "null"] }
      }
    },
    "sourceRef": {
      "type": "object",
      "required": ["id", "source_system", "source_entity", "source_id"],
      "properties": {
        "id": { "type": "string" },
        "source_system": { "type": "string" },
        "source_entity": { "type": "string" },
        "source_id": { "type": "string" },
        "source_section": { "type": ["string", "null"] },
        "confidence": { "type": ["number", "null"] },
        "manual_review": { "type": ["boolean", "null"] }
      }
    },
    "section": {
      "type": "object",
      "required": ["section_id", "doc_id", "section_type", "text"],
      "properties": {
        "section_id": { "type": "string" },
        "doc_id": { "type": "string" },
        "section_type": { "type": "string" },
        "text": { "type": "string" },
        "date": { "type": ["string", "null"] },
        "author": { "type": ["string", "null"] },
        "embedding_ready": { "type": "boolean" }
      }
    }
  }
}
